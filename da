-- Graphics + Sound to minimum | Auto on execute

local Settings = UserSettings():GetService("UserGameSettings")

-- Graphics
Settings.SavedQualityLevel = Enum.SavedQualitySetting.QualityLevel1
game:GetService("RunService"):Set3dRenderingEnabled(true)

-- Force via Lighting too
local Lighting = game:GetService("Lighting")
Lighting.GlobalShadows = false
Lighting.FogEnd = 9e9

-- Set render fidelity low on all parts
for _, v in ipairs(workspace:GetDescendants()) do
    if v:IsA("BasePart") then
        pcall(function() v.RenderFidelity = Enum.RenderFidelity.Automatic end)
    end
end

-- Sound volume to 0 (mute) or set to 1 for lowest audible
local SoundService = game:GetService("SoundService")
SoundService.RespectFilteringEnabled = true
SoundService:SetListener(Enum.ListenerType.Camera, nil)

-- Master volume — 0 = mute, change to 0.1 if u want just low
SoundService.AmbientReverb = Enum.ReverbType.NoReverb
SoundService.DistanceFactor = 1
SoundService.DopplerScale   = 0
SoundService.RolloffScale   = 1

-- Mute all active sounds
for _, s in ipairs(workspace:GetDescendants()) do
    if s:IsA("Sound") then
        pcall(function() s.Volume = 0 end)
    end
end

-- Also mute sounds inside players
for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
    if player.Character then
        for _, s in ipairs(player.Character:GetDescendants()) do
            if s:IsA("Sound") then
                pcall(function() s.Volume = 0 end)
            end
        end
    end
end

print("✅ Graphics → Level 1 | Sound → Muted, boss man.")
