    closeBtn.MouseButton1Click:Connect(dismiss)
    task.delay(duration, dismiss)
end

-- Runtime Theme / Accent updates
function Mercury:SetTheme(themeName)
    local t = self.Themes[themeName]
    if t then
        self.Theme = t
    end
end

function Mercury:SetAccent(color)
    if typeof(color) == "Color3" then
        self.Theme.Accent = color
        self.Theme.AccentGlow = Color3.new(
            math.min(color.R * 1.25, 1),
            math.min(color.G * 1.25, 1),
            math.min(color.B * 1.25, 1)
        )
        self.Theme.AccentDark = Color3.new(color.R * 0.65, color.G * 0.65, color.B * 0.65)
    end
end

