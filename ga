            local selLabel = create("TextLabel", {
                Name = "SelectedText",
                Size = UDim2.new(1, -30, 1, 0),
                Position = UDim2.new(0, 10, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(selected),
                TextColor3 = theme.Text,
                TextSize = 12,
                Font = fonts.Medium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Parent = selectBtn,
            })

            local chevron = create("ImageLabel", {
                Name = "Chevron",
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(1, -20, 0.5, -7),
                BackgroundTransparency = 1,
                Image = Icons.chevron_down,
                ImageColor3 = theme.TextMuted,
                Parent = selectBtn,
            })

            -- Item List Scroll Container
            local itemHolder = create("ScrollingFrame", {
                Name = "ItemList",
                Size = UDim2.new(1, -28, 0, 0),
                Position = UDim2.new(0, 14, 0, baseHeight + 4),
                BackgroundTransparency = 1,
                ScrollBarThickness = 2,
                ScrollBarImageColor3 = theme.Border,
                CanvasSize = UDim2.new(0, 0, 0, 0),
                AutomaticCanvasSize = Enum.AutomaticSize.Y,
                BorderSizePixel = 0,
                Parent = container,
            })
            addList(itemHolder, Enum.FillDirection.Vertical, 3)

            local function renderItems()
                for _, ch in ipairs(itemHolder:GetChildren()) do
                    if ch:IsA("TextButton") then ch:Destroy() end
                end

                for i, item in ipairs(items) do
                    local isSel = (item == selected)
                    local itemBtn = create("TextButton", {
                        Name = "Item_" .. tostring(item),
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = isSel and theme.AccentDark or theme.BackgroundAlt,
                        BackgroundTransparency = isSel and 0.4 or 0.6,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        LayoutOrder = i,
                        Parent = itemHolder,
                    })
                    addCorner(itemBtn, 6)

                    local itemLbl = create("TextLabel", {
                        Size = UDim2.new(1, -30, 1, 0),
                        Position = UDim2.new(0, 10, 0, 0),
                        BackgroundTransparency = 1,
                        Text = tostring(item),
                        TextColor3 = isSel and theme.Text or theme.TextDim,
                        TextSize = 12,
                        Font = isSel and fonts.Bold or fonts.Medium,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        Parent = itemBtn,
                    })

                    -- Check icon for active
                    if isSel then
                        create("ImageLabel", {
                            Size = UDim2.new(0, 14, 0, 14),
                            Position = UDim2.new(1, -20, 0.5, -7),
                            BackgroundTransparency = 1,
                            Image = Icons.check,
                            ImageColor3 = theme.AccentGlow,
                            Parent = itemBtn,
                        })
                    end

                    itemBtn.MouseEnter:Connect(function()
                        if item ~= selected then
                            tween(itemBtn, Tweens.Fast, { BackgroundTransparency = 0.3 })
                            tween(itemLbl, Tweens.Fast, { TextColor3 = theme.Text })
                        end
                    end)
                    itemBtn.MouseLeave:Connect(function()
                        if item ~= selected then
                            tween(itemBtn, Tweens.Fast, { BackgroundTransparency = 0.6 })
                            tween(itemLbl, Tweens.Fast, { TextColor3 = theme.TextDim })
                        end
                    end)

                    itemBtn.MouseButton1Click:Connect(function()
                        selected = item
                        selLabel.Text = tostring(item)
                        callback(item)
                        expanded = false
                        tween(chevron, Tweens.Fast, { Rotation = 0 })
                        tween(container, Tweens.Smooth, { Size = UDim2.new(1, 0, 0, baseHeight) })
                        renderItems()
                    end)
                end
            end

            renderItems()

            selectBtn.MouseButton1Click:Connect(function()
                expanded = not expanded
                tween(chevron, Tweens.Fast, { Rotation = expanded and 180 or 0 })

                local listH = math.min(#items * 31, 140)
                itemHolder.Size = UDim2.new(1, -28, 0, listH)
                local targetH = expanded and (baseHeight + 8 + listH) or baseHeight
                tween(container, Tweens.Smooth, { Size = UDim2.new(1, 0, 0, targetH) })
            end)

            -- Card hover
            container.MouseEnter:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.1 })
                tween(stroke, Tweens.Fast, { Transparency = 0.3 })
            end)
            container.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.Card, BackgroundTransparency = 0.25 })
                tween(stroke, Tweens.Fast, { Transparency = 0.6 })
            end)

            callback(default)

            return {
                Set = function(_, v)
                    selected = v
                    selLabel.Text = tostring(v)
                    renderItems()
                    callback(v)
                end,
                Get = function() return selected end,
                Refresh = function(_, newItems)
                    items = newItems or {}
                    renderItems()
                end,
            }
        end

