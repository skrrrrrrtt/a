    })

    -- Close (X) button
    local closeBtn = create("ImageButton", {
        Name = "Close",
        Size = UDim2.new(0, 16, 0, 16),
        Position = UDim2.new(1, -24, 0, 12),
        BackgroundTransparency = 1,
        Image = Icons.close,
        ImageColor3 = self.Theme.TextMuted,
        Parent = card,
    })

    closeBtn.MouseEnter:Connect(function()
        tween(closeBtn, Tweens.Fast, { ImageColor3 = self.Theme.Text })
    end)
    closeBtn.MouseLeave:Connect(function()
        tween(closeBtn, Tweens.Fast, { ImageColor3 = self.Theme.TextMuted })
    end)

    -- Progress bar at bottom
    local progTrack = create("Frame", {
        Name = "ProgTrack",
        Size = UDim2.new(1, 0, 0, 2),
