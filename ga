-- Automatic tab icon mapper based on tab name
local function getIconForTab(name)
    local lower = string.lower(name or "")
    if lower:find("combat") or lower:find("aim") or lower:find("gun") or lower:find("weapon") or lower:find("pvp") then
        return Icons.crosshair
    elseif lower:find("visual") or lower:find("esp") or lower:find("render") or lower:find("chams") or lower:find("view") then
        return Icons.eye
    elseif lower:find("move") or lower:find("speed") or lower:find("fly") or lower:find("player") or lower:find("tp") then
        return Icons.zap
    elseif lower:find("setting") or lower:find("config") or lower:find("option") then
        return Icons.settings
    elseif lower:find("misc") or lower:find("extra") or lower:find("util") or lower:find("other") then
        return Icons.folder
    elseif lower:find("theme") or lower:find("color") or lower:find("style") then
        return Icons.palette
    elseif lower:find("credit") or lower:find("info") or lower:find("about") then
        return Icons.info
    end
    return Icons.sparkles
end

