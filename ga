        function Tab:Button(opts)
            opts = opts or {}
            local name     = opts.Name or "Button"
            local desc     = opts.Description or opts.Desc
            local iconName = opts.Icon
            local callback = opts.Callback or function() end

            local baseHeight = (desc and desc ~= "") and 54 or 42
            local container, stroke = createCard(name, baseHeight, desc)

            -- Action Arrow Icon on Right
            local arrowIcon = create("ImageLabel", {
                Name = "Arrow",
                Size = UDim2.new(0, 16, 0, 16),
                Position = UDim2.new(1, -30, 0.5, -8),
                BackgroundTransparency = 1,
                Image = Icons[iconName] or Icons.chevron_right,
                ImageColor3 = theme.TextMuted,
                Parent = container,
            })

            local hitBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                Parent = container,
            })

            hitBtn.MouseButton1Click:Connect(function()
                rippleEffect(container, Mouse.X, Mouse.Y, theme.Accent)
                tween(stroke, Tweens.Fast, { Color = theme.AccentGlow, Transparency = 0.1 })
                task.delay(0.25, function()
                    tween(stroke, Tweens.Smooth, { Color = theme.Border, Transparency = 0.6 })
                end)
                callback()
            end)

            hitBtn.MouseEnter:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.1 })
                tween(stroke, Tweens.Fast, { Transparency = 0.3 })
                tween(arrowIcon, Tweens.Fast, { ImageColor3 = theme.AccentGlow, Position = UDim2.new(1, -26, 0.5, -8) })
            end)
            hitBtn.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.Card, BackgroundTransparency = 0.25 })
                tween(stroke, Tweens.Fast, { Transparency = 0.6 })
                tween(arrowIcon, Tweens.Fast, { ImageColor3 = theme.TextMuted, Position = UDim2.new(1, -30, 0.5, -8) })
            end)
        end

        -- ────────────────────────────────────────────────────────────
        -- 8. LABEL
        -- ────────────────────────────────────────────────────────────
        function Tab:Label(opts)
            opts = opts or {}
            local text  = opts.Text or "Label"
            local color = opts.Color or theme.TextDim

            local container = create("Frame", {
                Name = "LabelCard",
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = theme.Card,
                BackgroundTransparency = 0.7,
                BorderSizePixel = 0,
                Parent = tabContent,
            })
            container:SetAttribute("BaseTransparency", 0.7)
            addCorner(container, 6)
            addStroke(container, theme.Border, 1, 0.8)
            addPadding(container, 6, 12, 6, 12)

            local lbl = create("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text = text,
                TextColor3 = color,
                TextSize = 12,
                Font = fonts.Medium,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Parent = container,
            })

            return {
                Set = function(_, v) lbl.Text = v end,
                SetColor = function(_, c) lbl.TextColor3 = c end,
            }
        end

        -- ────────────────────────────────────────────────────────────
        -- 9. PARAGRAPH
        -- ────────────────────────────────────────────────────────────
        function Tab:Paragraph(opts)
            opts = opts or {}
            local title   = opts.Title or "Paragraph"
            local content = opts.Content or opts.Text or ""

            local container = create("Frame", {
                Name = "ParagraphCard",
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, 0, 0, 48),
                BackgroundColor3 = theme.Card,
                BackgroundTransparency = 0.35,
                BorderSizePixel = 0,
                Parent = tabContent,
            })
            container:SetAttribute("BaseTransparency", 0.35)
            addCorner(container, 8)
            addStroke(container, theme.Border, 1, 0.6)
            addPadding(container, 10, 14, 10, 14)

            local titleL = create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 16),
                BackgroundTransparency = 1,
                Text = title,
                TextColor3 = theme.Text,
                TextSize = 13,
                Font = fonts.Bold,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = container,
            })

            local bodyL = create("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.Y,
                Size = UDim2.new(1, 0, 0, 16),
                Position = UDim2.new(0, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = content,
                TextColor3 = theme.TextDim,
                TextSize = 11,
                Font = fonts.Regular,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextWrapped = true,
                Parent = container,
            })

            return {
                Set = function(_, newTitle, newContent)
                    if newTitle then titleL.Text = newTitle end
                    if newContent then bodyL.Text = newContent end
                end
            }
        end

        -- ────────────────────────────────────────────────────────────
        -- 10. SEPARATOR / SECTION HEADER
        -- ────────────────────────────────────────────────────────────
        function Tab:Separator(opts)
            opts = opts or {}
            local text = opts.Text or opts.Name

            local container = create("Frame", {
                Name = "Separator",
                Size = UDim2.new(1, 0, 0, text and 30 or 14),
                BackgroundTransparency = 1,
                Parent = tabContent,
            })
            container:SetAttribute("BaseTransparency", 1)

            if text then
                -- Left Accent Pip
                local pip = create("Frame", {
                    Size = UDim2.new(0, 3, 0, 12),
                    Position = UDim2.new(0, 4, 0, 8),
                    BackgroundColor3 = theme.AccentGlow,
                    BorderSizePixel = 0,
                    Parent = container,
                })
                addCorner(pip, 2)

                -- Header Text
                local titleLbl = create("TextLabel", {
                    AutomaticSize = Enum.AutomaticSize.X,
                    Size = UDim2.new(0, 0, 0, 16),
                    Position = UDim2.new(0, 14, 0, 6),
                    BackgroundTransparency = 1,
                    Text = string.upper(text),
                    TextColor3 = theme.TextMuted,
                    TextSize = 11,
                    Font = fonts.Bold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = container,
                })

                -- Divider line fading out
                local line = create("Frame", {
                    Size = UDim2.new(1, -20, 0, 1),
                    Position = UDim2.new(0, 14, 0, 24),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Parent = container,
                })
                addGradient(line, ColorSequence.new({
                    ColorSequenceKeypoint.new(0, theme.Border),
                    ColorSequenceKeypoint.new(1, theme.Background),
                }), NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0.4),
                    NumberSequenceKeypoint.new(1, 1),
                }), 0)
            else
                local line = create("Frame", {
                    Size = UDim2.new(1, -16, 0, 1),
                    Position = UDim2.new(0, 8, 0.5, 0),
                    BackgroundColor3 = theme.Border,
                    BackgroundTransparency = 0.7,
                    BorderSizePixel = 0,
                    Parent = container,
                })
            end
        end

        Tab.Section = Tab.Separator

        return Tab
    end

    -- Initial load toast notification
    task.spawn(function()
        task.wait(0.5)
        Mercury:Notify({
            Title = title,
            Message = "Mercury UI initialized smoothly.",
            Type = "Success",
            Duration = 3,
        })
    end)

    table.insert(self.Windows, { Gui = screenGui, State = windowState })
    return Window
end

return Mercury
