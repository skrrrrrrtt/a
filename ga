                BorderSizePixel = 0,
                ClipsDescendants = false,
                Parent = tabContent,
            })
            container:SetAttribute("BaseTransparency", 0.25)
            addCorner(container, 8)
            local stroke = addStroke(container, theme.Border, 1, 0.6)

            -- Subtle gradient on card border
            addGradient(stroke, ColorSequence.new({
                ColorSequenceKeypoint.new(0, theme.BorderLight),
                ColorSequenceKeypoint.new(1, theme.Border),
            }), nil, 60)

            -- Title & optional description
            local titleY = (desc and desc ~= "") and 6 or 0
            local titleHeight = (desc and desc ~= "") and 16 or cardHeight

            local titleLbl = create("TextLabel", {
                Name = "Title",
                Size = UDim2.new(0.65, 0, 0, titleHeight),
                Position = UDim2.new(0, 14, 0, titleY),
                BackgroundTransparency = 1,
                Text = name,
                TextColor3 = theme.Text,
                TextSize = 13,
                Font = fonts.Medium,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = container,
            })

            if desc and desc ~= "" then
                create("TextLabel", {
                    Name = "Description",
                    Size = UDim2.new(0.65, 0, 0, 14),
                    Position = UDim2.new(0, 14, 0, 24),
