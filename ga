        local Tab = {}

        -- Helper for consistent card creation
        local function createCard(name, height, desc)
            local cardHeight = height or 42
            if desc and desc ~= "" then
                cardHeight = cardHeight + 14
            end

            local container = create("Frame", {
                Name = "Card_" .. name,
                Size = UDim2.new(1, 0, 0, cardHeight),
                BackgroundColor3 = theme.Card,
