        -- Tab Switching
        local function activateTab()
            if windowState.ActiveTab == tabData then return end

            -- Deactivate previous tab
            if windowState.ActiveTab then
                local prev = windowState.ActiveTab
                prev.Content.Visible = false
                tween(prev.Button, Tweens.Fast, { BackgroundTransparency = 1 })
                tween(prev.Label, Tweens.Fast, { TextColor3 = theme.TextDim })
                tween(prev.Icon, Tweens.Fast, { ImageColor3 = theme.TextMuted })
                tween(prev.Indicator, Tweens.Fast, { Size = UDim2.new(0, 3, 0, 0) })
            end

            -- Activate this tab
            windowState.ActiveTab = tabData
            tabContent.Visible = true
            tabContent.CanvasPosition = Vector2.new(0, 0)

            tween(tabBtn, Tweens.Medium, { BackgroundColor3 = theme.AccentDark, BackgroundTransparency = 0.75 })
            tween(tabLabel, Tweens.Medium, { TextColor3 = theme.Text })
            tween(iconImg, Tweens.Medium, { ImageColor3 = theme.AccentGlow })
            tween(indicator, Tweens.Spring, { Size = UDim2.new(0, 3, 0, 20) })

            -- Staggered fade in animation on elements
            for _, child in ipairs(tabContent:GetChildren()) do
                if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    local targetT = child:GetAttribute("BaseTransparency") or 0.2
                    child.BackgroundTransparency = 1
                    tween(child, Tweens.Fast, { BackgroundTransparency = targetT })
                end
            end
        end

        tabBtn.MouseButton1Click:Connect(activateTab)

        tabBtn.MouseEnter:Connect(function()
            if windowState.ActiveTab ~= tabData then
                tween(tabBtn, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.5 })
                tween(tabLabel, Tweens.Fast, { TextColor3 = theme.Text })
