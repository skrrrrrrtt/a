                tween(tabLabel, Tweens.Fast, { TextColor3 = theme.TextDim })
                tween(iconImg, Tweens.Fast, { ImageColor3 = theme.TextMuted })
            end
        end)

        -- Auto-activate first tab
        if #windowState.Tabs == 1 then
            activateTab()
        end

