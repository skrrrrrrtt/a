            end

            return container, stroke, titleLbl
        end

        -- ────────────────────────────────────────────────────────────
        -- 1. TOGGLE
        -- ────────────────────────────────────────────────────────────
        function Tab:Toggle(opts)
            opts = opts or {}
            local name        = opts.Name or "Toggle"
            local desc        = opts.Description or opts.Desc
            local default     = opts.Default or false
            local callback    = opts.Callback or function() end
            local state       = default

            local container, stroke = createCard(name, 42, desc)

            -- Switch Track
            local track = create("Frame", {
                Name = "SwitchTrack",
                Size = UDim2.new(0, 38, 0, 20),
                Position = UDim2.new(1, -52, 0.5, -10),
                BackgroundColor3 = state and theme.Accent or theme.BackgroundAlt,
                BorderSizePixel = 0,
                Parent = container,
            })
            addCorner(track, 10)
            local trackStroke = addStroke(track, state and theme.AccentGlow or theme.Border, 1, 0.5)

            -- Switch Knob
            local knob = create("Frame", {
                Name = "Knob",
                Size = UDim2.new(0, 14, 0, 14),
                Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                Parent = track,
            })
            addCorner(knob, 7)

            local function updateToggle(v)
                state = v
                tween(track, Tweens.Fast, {
                    BackgroundColor3 = v and theme.Accent or theme.BackgroundAlt
                })
                tween(trackStroke, Tweens.Fast, {
                    Color = v and theme.AccentGlow or theme.Border,
                    Transparency = v and 0.2 or 0.5
                })
                tween(knob, Tweens.Spring, {
                    Position = v and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                })
                callback(v)
            end

            -- Click interaction
            local hitBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                Parent = container,
            })

            hitBtn.MouseButton1Click:Connect(function()
                rippleEffect(container, Mouse.X, Mouse.Y, state and theme.Border or theme.Accent)
                updateToggle(not state)
            end)

            hitBtn.MouseEnter:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.1 })
                tween(stroke, Tweens.Fast, { Transparency = 0.3 })
            end)
            hitBtn.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.Card, BackgroundTransparency = 0.25 })
                tween(stroke, Tweens.Fast, { Transparency = 0.6 })
            end)

            if default then callback(true) end

            return {
                Set = function(_, v) updateToggle(v) end,
                Get = function() return state end,
            }
        end

        -- ────────────────────────────────────────────────────────────
        -- 2. SLIDER
        -- ────────────────────────────────────────────────────────────
        function Tab:Slider(opts)
            opts = opts or {}
            local name      = opts.Name or "Slider"
            local desc      = opts.Description or opts.Desc
            local min       = opts.Min or 0
            local max       = opts.Max or 100
            local default   = opts.Default or min
            local increment = opts.Increment or 1
            local suffix    = opts.Suffix or ""
            local callback  = opts.Callback or function() end
            local value     = default

            local baseHeight = (desc and desc ~= "") and 66 or 54
            local container, stroke = createCard(name, baseHeight, desc)

            -- Value Display Pill Badge (Directly editable by clicking!)
            local valueBadge = create("Frame", {
                Name = "ValueBadge",
                AutomaticSize = Enum.AutomaticSize.X,
                Size = UDim2.new(0, 0, 0, 22),
                Position = UDim2.new(1, -14, 0, 8),
                AnchorPoint = Vector2.new(1, 0),
                BackgroundColor3 = theme.BackgroundAlt,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
                Parent = container,
            })
            addCorner(valueBadge, 6)
            local valStroke = addStroke(valueBadge, theme.Border, 1, 0.5)
            addPadding(valueBadge, 2, 8, 2, 8)

            local valBox = create("TextBox", {
                AutomaticSize = Enum.AutomaticSize.X,
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = tostring(value) .. (suffix ~= "" and (" " .. suffix) or ""),
                TextColor3 = theme.AccentGlow,
                TextSize = 12,
                Font = fonts.Bold,
                ClearTextOnFocus = false,
                Parent = valueBadge,
            })

            -- Slider Track Slot
            local trackY = (desc and desc ~= "") and 44 or 34
            local trackFrame = create("Frame", {
                Name = "TrackSlot",
                Size = UDim2.new(1, -28, 0, 6),
                Position = UDim2.new(0, 14, 0, trackY),
                BackgroundColor3 = theme.BackgroundAlt,
                BorderSizePixel = 0,
                ClipsDescendants = false,
                Parent = container,
            })
            addCorner(trackFrame, 3)
            addStroke(trackFrame, theme.Border, 1, 0.6)

            -- Slider Fill Bar
            local pct = math.clamp((default - min) / (max - min), 0, 1)
            local fillBar = create("Frame", {
                Name = "Fill",
                Size = UDim2.new(pct, 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                Parent = trackFrame,
            })
            addCorner(fillBar, 3)
            addGradient(fillBar, ColorSequence.new({
                ColorSequenceKeypoint.new(0, theme.AccentDark),
                ColorSequenceKeypoint.new(1, theme.AccentGlow),
            }), nil, 0)

            -- Slider Thumb Knob
            local thumb = create("Frame", {
                Name = "Thumb",
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(pct, -7, 0.5, -7),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 10,
                Parent = trackFrame,
            })
            addCorner(thumb, 7)
            local thumbStroke = addStroke(thumb, theme.Accent, 2, 0.2)

            local dragging = false

            local function updateSlider(inputX)
                local absPos = trackFrame.AbsolutePosition.X
                local absSize = trackFrame.AbsoluteSize.X
                local rel = math.clamp((inputX - absPos) / absSize, 0, 1)

                local raw = min + (max - min) * rel
                if increment >= 1 then
                    value = math.floor(raw / increment + 0.5) * increment
                else
                    value = math.floor(raw / increment + 0.5) * increment
                    value = tonumber(string.format("%." .. math.ceil(-math.log10(increment)) .. "f", value))
                end
                value = math.clamp(value, min, max)

                local newPct = (value - min) / (max - min)
                tween(fillBar, Tweens.Instant, { Size = UDim2.new(newPct, 0, 1, 0) })
                tween(thumb, Tweens.Instant, { Position = UDim2.new(newPct, -7, 0.5, -7) })
                valBox.Text = tostring(value) .. (suffix ~= "" and (" " .. suffix) or "")

                callback(value)
            end

            -- Global dragging handler
            trackFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    tween(thumb, Tweens.Fast, { Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(thumb.Position.X.Scale, -9, 0.5, -9) })
                    tween(valStroke, Tweens.Fast, { Color = theme.Accent, Transparency = 0.2 })
                    updateSlider(input.Position.X)
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        local curPct = (value - min) / (max - min)
                        tween(thumb, Tweens.Fast, { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(curPct, -7, 0.5, -7) })
                        tween(valStroke, Tweens.Fast, { Color = theme.Border, Transparency = 0.5 })
                    end
                end
            end)

            -- Direct text entry on value badge
            valBox.FocusLost:Connect(function()
                local num = tonumber(valBox.Text:gsub("[^%d.-]", ""))
                if num then
                    value = math.clamp(num, min, max)
                end
                local p = (value - min) / (max - min)
                tween(fillBar, Tweens.Fast, { Size = UDim2.new(p, 0, 1, 0) })
                tween(thumb, Tweens.Fast, { Position = UDim2.new(p, -7, 0.5, -7) })
                valBox.Text = tostring(value) .. (suffix ~= "" and (" " .. suffix) or "")
                callback(value)
            end)

            -- Card hover
            container.MouseEnter:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.1 })
                tween(stroke, Tweens.Fast, { Transparency = 0.3 })
            end)
            container.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.Card, BackgroundTransparency = 0.25 })
                tween(stroke, Tweens.Fast, { Transparency = 0.6 })
            end)

            callback(default)

            return {
                Set = function(_, v)
                    value = math.clamp(v, min, max)
                    local p = (value - min) / (max - min)
                    tween(fillBar, Tweens.Fast, { Size = UDim2.new(p, 0, 1, 0) })
                    tween(thumb, Tweens.Fast, { Position = UDim2.new(p, -7, 0.5, -7) })
                    valBox.Text = tostring(value) .. (suffix ~= "" and (" " .. suffix) or "")
                    callback(value)
                end,
                Get = function() return value end,
            }
        end

