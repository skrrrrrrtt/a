                Parent = container,
            })
            addCorner(keyBtn, 6)
            local keyStroke = addStroke(keyBtn, theme.Border, 1, 0.5)
            addPadding(keyBtn, 2, 10, 2, 10)

            local keyLabel = create("TextLabel", {
                AutomaticSize = Enum.AutomaticSize.X,
                Size = UDim2.new(0, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "[" .. getKeyName(current) .. "]",
                TextColor3 = theme.AccentGlow,
                TextSize = 12,
                Font = fonts.Bold,
                Parent = keyBtn,
            })

            keyBtn.MouseButton1Click:Connect(function()
                listening = true
                keyLabel.Text = "[ ... ]"
                tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.AccentDark, BackgroundTransparency = 0.2 })
                tween(keyStroke, Tweens.Fast, { Color = theme.AccentGlow, Transparency = 0.2 })
            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode == Enum.KeyCode.Escape then
                            listening = false
                            keyLabel.Text = "[" .. getKeyName(current) .. "]"
                            tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.BackgroundAlt, BackgroundTransparency = 0.3 })
                            tween(keyStroke, Tweens.Fast, { Color = theme.Border, Transparency = 0.5 })
                            return
                        end
                        current = input.KeyCode
                        listening = false
                        keyLabel.Text = "[" .. getKeyName(current) .. "]"
                        tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.BackgroundAlt, BackgroundTransparency = 0.3 })
                        tween(keyStroke, Tweens.Fast, { Color = theme.Border, Transparency = 0.5 })
                        callback(current)
                    elseif input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                        current = input.UserInputType
                        listening = false
                        keyLabel.Text = "[" .. getKeyName(current) .. "]"
                        tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.BackgroundAlt, BackgroundTransparency = 0.3 })
                        tween(keyStroke, Tweens.Fast, { Color = theme.Border, Transparency = 0.5 })
                        callback(current)
                    end
                else
                    if not processed then
                        if input.KeyCode == current or input.UserInputType == current then
                            onPress()
                        end
                    end
                end
            end)

            container.MouseEnter:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.CardHover, BackgroundTransparency = 0.1 })
                tween(stroke, Tweens.Fast, { Transparency = 0.3 })
            end)
            container.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundColor3 = theme.Card, BackgroundTransparency = 0.25 })
                tween(stroke, Tweens.Fast, { Transparency = 0.6 })
            end)

            return {
                Set = function(_, k)
                    current = k
                    keyLabel.Text = "[" .. getKeyName(current) .. "]"
                    callback(current)
                end,
                Get = function() return current end,
            }
        end

