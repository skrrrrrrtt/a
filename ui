-- Utility
local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props)
    t:Play()
    return t
end

local function create(className, properties, children)
    local inst = Instance.new(className)
    for k, v in pairs(properties or {}) do
        inst[k] = v
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    return inst
end

local function addCorner(parent, radius)
    return create("UICorner", { CornerRadius = UDim.new(0, radius or 6), Parent = parent })
end

local function addStroke(parent, color, thickness, transparency)
    return create("UIStroke", {
        Color = color or Mercury.Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function addPadding(parent, top, right, bottom, left)
    return create("UIPadding", {
        PaddingTop    = UDim.new(0, top or 0),
        PaddingRight  = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft   = UDim.new(0, left or 0),
        Parent = parent,
    })
end

local function addList(parent, direction, padding, hAlign, vAlign, sortOrder)
    return create("UIListLayout", {
        FillDirection = direction or Enum.FillDirection.Vertical,
        Padding = UDim.new(0, padding or 0),
        HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
        VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
        SortOrder = sortOrder or Enum.SortOrder.LayoutOrder,
        Parent = parent,
    })
end

local function getKeyName(keyCode)
    local name = keyCode.Name
    local map = {
        LeftShift = "LShift", RightShift = "RShift",
        LeftControl = "LCtrl", RightControl = "RCtrl",
        LeftAlt = "LAlt", RightAlt = "RAlt",
        BackSlash = "\\", Slash = "/",
        Semicolon = ";", Comma = ",", Period = ".",
        Minus = "-", Equals = "=",
        LeftBracket = "[", RightBracket = "]",
        BackSpace = "Back", CapsLock = "Caps",
    }
    return map[name] or name
end

local function rippleEffect(button, x, y, accent)
    local abs = button.AbsolutePosition
    local sz = button.AbsoluteSize
    local relX = x - abs.X
    local relY = y - abs.Y
    local maxDim = math.max(sz.X, sz.Y) * 2

    local ripple = create("Frame", {
        Name = "Ripple",
        Position = UDim2.new(0, relX, 0, relY),
        Size = UDim2.new(0, 0, 0, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = accent or Mercury.Theme.Accent,
        BackgroundTransparency = 0.7,
        BorderSizePixel = 0,
        ZIndex = 99,
        Parent = button,
    })
    addCorner(ripple, 9999)
    button.ClipsDescendants = true

    tween(ripple, TweenInfo.new(0.45, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, maxDim, 0, maxDim),
        BackgroundTransparency = 1,
    }).Completed:Connect(function()
        ripple:Destroy()
    end)
end

-- Notification
local NotifHolder

local function ensureNotifHolder()
    if NotifHolder and NotifHolder.Parent then return end
    local gui = create("ScreenGui", {
        Name = "MercuryNotifications",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 9999,
    })
    pcall(function() gui.Parent = game:GetService("CoreGui") end)
    if not gui.Parent then gui.Parent = Player:WaitForChild("PlayerGui") end

    NotifHolder = create("Frame", {
        Name = "Holder",
        Size = UDim2.new(0, 300, 1, 0),
        Position = UDim2.new(1, -315, 0, 0),
        BackgroundTransparency = 1,
        Parent = gui,
    })
    addList(NotifHolder, Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Bottom)
    addPadding(NotifHolder, 0, 0, 15, 0)
end

function Mercury:Notify(options)
    ensureNotifHolder()
    options = options or {}
    local title = options.Title or "Mercury"
    local message = options.Message or ""
    local duration = options.Duration or 4

    local card = create("Frame", {
        Name = "Notif",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = self.Theme.Surface,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = NotifHolder,
    })
    addCorner(card, 8)
    local cardStroke = addStroke(card, self.Theme.Border, 1, 1)

    local accent = create("Frame", {
        Name = "Accent",
        Size = UDim2.new(0, 3, 1, -12),
        Position = UDim2.new(0, 8, 0, 6),
        BackgroundColor3 = self.Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = card,
    })
    addCorner(accent, 2)

    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -30, 0, 18),
        Position = UDim2.new(0, 20, 0, 10),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = self.Theme.Text,
        TextSize = 13,
        Font = self.Fonts.Bold,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTransparency = 1,
        Parent = card,
    })

    local msgLabel = create("TextLabel", {
        Name = "Message",
        Size = UDim2.new(1, -30, 0, 14),
        Position = UDim2.new(0, 20, 0, 30),
        BackgroundTransparency = 1,
        Text = message,
        TextColor3 = self.Theme.TextDim,
        TextSize = 12,
        Font = self.Fonts.Regular,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        TextTransparency = 1,
        Parent = card,
    })

    local bar = create("Frame", {
        Name = "Progress",
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = self.Theme.Accent,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = card,
    })

    -- Animate in
    tween(card, Tweens.Smooth, { Size = UDim2.new(1, 0, 0, 54), BackgroundTransparency = 0.05 })
    tween(cardStroke, Tweens.Medium, { Transparency = 0.5 })
    tween(accent, Tweens.Medium, { BackgroundTransparency = 0 })
    tween(titleLabel, Tweens.Medium, { TextTransparency = 0 })
    tween(msgLabel, Tweens.Medium, { TextTransparency = 0 })

    -- Progress bar countdown
    tween(bar, TweenInfo.new(duration, Enum.EasingStyle.Linear), { Size = UDim2.new(0, 0, 0, 2) })

    task.delay(duration, function()
        tween(card, Tweens.Smooth, { Size = UDim2.new(1, 0, 0, 0), BackgroundTransparency = 1 })
        tween(cardStroke, Tweens.Fast, { Transparency = 1 })
        tween(accent, Tweens.Fast, { BackgroundTransparency = 1 })
        tween(titleLabel, Tweens.Fast, { TextTransparency = 1 })
        tween(msgLabel, Tweens.Fast, { TextTransparency = 1 })
        task.wait(0.4)
        card:Destroy()
    end)
end

