            end)

            UserInputService.InputBegan:Connect(function(input, processed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        if input.KeyCode == Enum.KeyCode.Escape then
                            -- Cancel
                            listening = false
                            keyBtn.Text = "[" .. getKeyName(current) .. "]"
                            tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.Background, TextColor3 = theme.TextDim })
                            return
                        end
                        current = input.KeyCode
                        listening = false
                        keyBtn.Text = "[" .. getKeyName(current) .. "]"
                        tween(keyBtn, Tweens.Fast, { BackgroundColor3 = theme.Background, TextColor3 = theme.TextDim })
                        callback(current)
                    end
                else
                    if not processed and input.KeyCode == current then
                        onPress()
                    end
                end
            end)

            -- Hover
            local hoverBtn = create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = "",
                ZIndex = 0,
                Parent = container,
