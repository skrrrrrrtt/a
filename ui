                    BackgroundTransparency = 0.5,
                    BorderSizePixel = 0,
                    Text = item,
                    TextColor3 = (item == selected) and theme.Accent or theme.TextDim,
                    TextSize = 12,
                    Font = fonts.Medium,
                    AutoButtonColor = false,
                    LayoutOrder = i,
                    Parent = itemHolder,
                })
                addCorner(itemBtn, 6)

                itemBtn.MouseEnter:Connect(function()
                    tween(itemBtn, Tweens.Fast, { BackgroundTransparency = 0.2, TextColor3 = theme.Text })
                end)
                itemBtn.MouseLeave:Connect(function()
                    local c = (item == selected) and theme.Accent or theme.TextDim
                    tween(itemBtn, Tweens.Fast, { BackgroundTransparency = 0.5, TextColor3 = c })
                end)

                itemBtn.MouseButton1Click:Connect(function()
                    selected = item
                    selectedBtn.Text = item
                    callback(item)

                    -- Update highlight
                    for _, ch in ipairs(itemHolder:GetChildren()) do
                        if ch:IsA("TextButton") then
                            local isSelected = (ch.Text == selected)
                            tween(ch, Tweens.Fast, {
                                TextColor3 = isSelected and theme.Accent or theme.TextDim
                            })
                        end
                    end

                    -- Collapse
                    expanded = false
                    tween(arrow, Tweens.Fast, { Rotation = 0 })
                    tween(container, Tweens.Smooth, {
                        Size = UDim2.new(1, 0, 0, 38)
                    })
                end)
