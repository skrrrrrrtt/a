        -- SLIDER
        function Tab:Slider(opts)
            opts = opts or {}
            local name = opts.Name or "Slider"
            local min = opts.Min or 0
            local max = opts.Max or 100
            local default = opts.Default or min
            local increment = opts.Increment or 1
            local suffix = opts.Suffix or ""
            local callback = opts.Callback or function() end
            local value = default

            local container = create("Frame", {
                Name = "Slider_" .. name,
                Size = UDim2.new(1, 0, 0, 50),
                BackgroundColor3 = theme.SurfaceAlt,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
                Parent = tabContent,
            })
            container:SetAttribute("TargetTransparency", 0.3)
            addCorner(container, 8)
            addStroke(container, theme.Border, 1, 0.7)

            local label = create("TextLabel", {
                Size = UDim2.new(0.6, 0, 0, 20),
                Position = UDim2.new(0, 14, 0, 6),
                BackgroundTransparency = 1,
                Text = name,
                TextColor3 = theme.Text,
                TextSize = 13,
                Font = fonts.Medium,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = container,
            })

            local valueLabel = create("TextLabel", {
                Name = "Value",
                Size = UDim2.new(0.4, -14, 0, 20),
                Position = UDim2.new(0.6, 0, 0, 6),
                BackgroundTransparency = 1,
                Text = tostring(value) .. suffix,
                TextColor3 = theme.Accent,
                TextSize = 13,
                Font = fonts.Bold,
                TextXAlignment = Enum.TextXAlignment.Right,
                Parent = container,
            })

            -- Track
            local trackFrame = create("Frame", {
                Name = "Track",
                Size = UDim2.new(1, -28, 0, 6),
                Position = UDim2.new(0, 14, 0, 34),
                BackgroundColor3 = theme.Border,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                Parent = container,
            })
            addCorner(trackFrame, 3)

            -- Fill
            local pct = math.clamp((default - min) / (max - min), 0, 1)
            local fill = create("Frame", {
                Name = "Fill",
                Size = UDim2.new(pct, 0, 1, 0),
                BackgroundColor3 = theme.Accent,
                BorderSizePixel = 0,
                Parent = trackFrame,
            })
            addCorner(fill, 3)

            -- Thumb
            local thumb = create("Frame", {
                Name = "Thumb",
                Size = UDim2.new(0, 14, 0, 14),
                Position = UDim2.new(pct, -7, 0.5, -7),
                AnchorPoint = Vector2.new(0, 0),
                BackgroundColor3 = Color3.new(1, 1, 1),
                BorderSizePixel = 0,
                ZIndex = 5,
                Parent = trackFrame,
            })
            addCorner(thumb, 7)
            addStroke(thumb, theme.Accent, 2, 0.3)

            local dragging = false

            local function updateSlider(inputX)
                local absPos = trackFrame.AbsolutePosition.X
                local absSize = trackFrame.AbsoluteSize.X
                local rel = math.clamp((inputX - absPos) / absSize, 0, 1)

                -- Snap to increment
                local raw = min + (max - min) * rel
                if increment >= 1 then
                    value = math.floor(raw / increment + 0.5) * increment
                else
                    value = math.floor(raw / increment + 0.5) * increment
                    value = tonumber(string.format("%." .. math.ceil(-math.log10(increment)) .. "f", value))
                end
                value = math.clamp(value, min, max)

                local newPct = (value - min) / (max - min)
                tween(fill, Tweens.Fast, { Size = UDim2.new(newPct, 0, 1, 0) })
                tween(thumb, Tweens.Fast, { Position = UDim2.new(newPct, -7, 0.5, -7) })
                valueLabel.Text = tostring(value) .. suffix

                callback(value)
            end

            trackFrame.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input.Position.X)
                    -- Scale up thumb
                    tween(thumb, Tweens.Bounce, { Size = UDim2.new(0, 18, 0, 18), Position = UDim2.new(thumb.Position.X.Scale, -9, 0.5, -9) })
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input.Position.X)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    if dragging then
                        dragging = false
                        -- Scale down thumb
                        local currentPct = (value - min) / (max - min)
                        tween(thumb, Tweens.Bounce, { Size = UDim2.new(0, 14, 0, 14), Position = UDim2.new(currentPct, -7, 0.5, -7) })
                    end
                end
            end)

            -- Hover
            container.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.15 })
                end
            end)
            container.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.3 })
                end
            end)

            callback(default)

            return {
                Set = function(_, v)
                    value = math.clamp(v, min, max)
                    local p = (value - min) / (max - min)
                    tween(fill, Tweens.Smooth, { Size = UDim2.new(p, 0, 1, 0) })
                    tween(thumb, Tweens.Smooth, { Position = UDim2.new(p, -7, 0.5, -7) })
                    valueLabel.Text = tostring(value) .. suffix
                    callback(value)
                end,
                Get = function() return value end,
            }
        end

