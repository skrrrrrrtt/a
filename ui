function Mercury:Window(options)
    options = options or {}
    local title    = options.Title or "Mercury"
    local subtitle = options.Subtitle or ""
    local size     = options.Size or UDim2.new(0, 560, 0, 380)
    local toggleKey = options.Keybind or Enum.KeyCode.RightControl

    if options.Accent then
        self.Theme.Accent = options.Accent
        self.Theme.AccentDark = Color3.new(
            options.Accent.R * 0.72,
            options.Accent.G * 0.72,
            options.Accent.B * 0.72
        )
    end

    local theme = self.Theme
    local fonts = self.Fonts

    -- ScreenGui
    local screenGui = create("ScreenGui", {
        Name = "Mercury_" .. title,
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 1000,
    })
    pcall(function() screenGui.Parent = game:GetService("CoreGui") end)
    if not screenGui.Parent then screenGui.Parent = Player:WaitForChild("PlayerGui") end

    -- Main frame
    local mainFrame = create("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = theme.Background,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Parent = screenGui,
    })
    addCorner(mainFrame, 10)
    addStroke(mainFrame, theme.Border, 1, 0.3)

    -- Shadow
    local shadow = create("ImageLabel", {
        Name = "Shadow",
        Size = UDim2.new(1, 40, 1, 40),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        Image = "rbxassetid://5554236805",
        ImageColor3 = Color3.new(0, 0, 0),
        ImageTransparency = 0.6,
        ScaleType = Enum.ScaleType.Slice,
        SliceCenter = Rect.new(23, 23, 277, 277),
        ZIndex = 0,
        Parent = mainFrame,
    })

    -- Open animation
    tween(mainFrame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = size,
    })

    -- State
    local windowState = {
        Open = true,
        Tabs = {},
        ActiveTab = nil,
        Dragging = false,
    }

    -- Drag
    local dragStart, startPos
    local dragInput, dragConn, dragEndConn

    local titleBar = create("Frame", {
        Name = "TitleBar",
        Size = UDim2.new(1, 0, 0, 42),
        BackgroundTransparency = 1,
        Parent = mainFrame,
    })

    titleBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            windowState.Dragging = true
            dragStart = input.Position
            startPos = mainFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    windowState.Dragging = false
                end
            end)
        end
    end)

    titleBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and windowState.Dragging then
            local delta = input.Position - dragStart
            local targetPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            tween(mainFrame, Tweens.Fast, { Position = targetPos })
        end
    end)

    -- Title
    local titleLabel = create("TextLabel", {
        Name = "Title",
        Size = UDim2.new(0, 200, 0, 42),
        Position = UDim2.new(0, 16, 0, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = theme.Text,
        TextSize = 15,
        Font = fonts.Bold,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = titleBar,
    })

    if subtitle ~= "" then
        create("TextLabel", {
            Name = "Subtitle",
            Size = UDim2.new(0, 200, 0, 42),
            Position = UDim2.new(0, 16 + titleLabel.TextBounds.X + 8, 0, 1),
            BackgroundTransparency = 1,
            Text = subtitle,
            TextColor3 = theme.TextMuted,
            TextSize = 12,
            Font = fonts.Regular,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = titleBar,
        })
    end

    -- Close / Minimize buttons
    local btnContainer = create("Frame", {
        Name = "WindowButtons",
        Size = UDim2.new(0, 70, 0, 42),
        Position = UDim2.new(1, -70, 0, 0),
        BackgroundTransparency = 1,
        Parent = titleBar,
    })

    local minimizeBtn = create("TextButton", {
        Name = "Minimize",
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(0, 4, 0.5, -14),
        BackgroundColor3 = theme.SurfaceAlt,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = btnContainer,
    })
    addCorner(minimizeBtn, 6)

    local minLine = create("Frame", {
        Size = UDim2.new(0, 10, 0, 2),
        Position = UDim2.new(0.5, -5, 0.5, -1),
        BackgroundColor3 = theme.TextDim,
        BorderSizePixel = 0,
        Parent = minimizeBtn,
    })

    local closeBtn = create("TextButton", {
        Name = "Close",
        Size = UDim2.new(0, 28, 0, 28),
        Position = UDim2.new(0, 36, 0.5, -14),
        BackgroundColor3 = theme.SurfaceAlt,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
        Parent = btnContainer,
    })
    addCorner(closeBtn, 6)

    -- X icon for close
    local x1 = create("Frame", {
        Size = UDim2.new(0, 12, 0, 2),
        Position = UDim2.new(0.5, -6, 0.5, -1),
        AnchorPoint = Vector2.new(0, 0),
        BackgroundColor3 = theme.TextDim,
        BorderSizePixel = 0,
        Rotation = 45,
        Parent = closeBtn,
    })
    local x2 = create("Frame", {
        Size = UDim2.new(0, 12, 0, 2),
        Position = UDim2.new(0.5, -6, 0.5, -1),
        AnchorPoint = Vector2.new(0, 0),
        BackgroundColor3 = theme.TextDim,
        BorderSizePixel = 0,
        Rotation = -45,
        Parent = closeBtn,
    })

    -- Button hover effects
    for _, btn in ipairs({minimizeBtn, closeBtn}) do
        btn.MouseEnter:Connect(function()
            tween(btn, Tweens.Fast, { BackgroundTransparency = 0.2 })
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, Tweens.Fast, { BackgroundTransparency = 0.5 })
        end)
    end

    closeBtn.MouseButton1Click:Connect(function()
        tween(mainFrame, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, 0, 0, 0),
        })
        task.wait(0.4)
        screenGui:Destroy()
    end)

    -- Divider under title bar
    create("Frame", {
        Name = "Divider",
        Size = UDim2.new(1, 0, 0, 1),
        Position = UDim2.new(0, 0, 0, 42),
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = mainFrame,
    })

    -- Sidebar
    local sidebar = create("Frame", {
        Name = "Sidebar",
        Size = UDim2.new(0, 140, 1, -43),
        Position = UDim2.new(0, 0, 0, 43),
        BackgroundColor3 = theme.Surface,
        BackgroundTransparency = 0.3,
        BorderSizePixel = 0,
        Parent = mainFrame,
    })

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        Size = UDim2.new(1, -16, 1, -16),
        Position = UDim2.new(0, 8, 0, 8),
        BackgroundTransparency = 1,
        ScrollBarThickness = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        BorderSizePixel = 0,
        Parent = sidebar,
    })
    addList(tabList, Enum.FillDirection.Vertical, 4)

    -- Sidebar right border
    create("Frame", {
        Name = "SidebarBorder",
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = theme.Border,
        BackgroundTransparency = 0.5,
        BorderSizePixel = 0,
        Parent = sidebar,
    })

    -- Content container
    local contentArea = create("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -141, 1, -43),
        Position = UDim2.new(0, 141, 0, 43),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        Parent = mainFrame,
    })

    -- Toggle visibility keybind
    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == toggleKey then
            windowState.Open = not windowState.Open
            if windowState.Open then
                screenGui.Enabled = true
                mainFrame.Size = UDim2.new(0, 0, 0, 0)
                tween(mainFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
                    Size = size,
                })
            else
                tween(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
                    Size = UDim2.new(0, 0, 0, 0),
                })
                task.wait(0.35)
                if not windowState.Open then
                    screenGui.Enabled = false
                end
            end
        end
    end)

    -- Minimize
    minimizeBtn.MouseButton1Click:Connect(function()
        windowState.Open = false
        tween(mainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.new(0, size.X.Offset, 0, 0),
        })
        task.wait(0.35)
        if not windowState.Open then
            screenGui.Enabled = false
        end
    end)

    -- ============================================================
    -- TAB
    -- ============================================================
    local Window = {}

    function Window:Tab(tabOptions)
        tabOptions = tabOptions or {}
        local tabName = tabOptions.Name or "Tab"
        local layoutOrder = #windowState.Tabs + 1

        -- Tab button in sidebar
        local tabBtn = create("TextButton", {
            Name = "Tab_" .. tabName,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = theme.Accent,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = layoutOrder,
            Parent = tabList,
        })
        addCorner(tabBtn, 6)

        -- Active indicator bar on left
        local indicator = create("Frame", {
            Name = "Indicator",
            Size = UDim2.new(0, 3, 0, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            Parent = tabBtn,
        })
        addCorner(indicator, 2)

        local tabLabel = create("TextLabel", {
            Name = "Label",
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 14, 0, 0),
            BackgroundTransparency = 1,
            Text = tabName,
            TextColor3 = theme.TextDim,
            TextSize = 13,
            Font = fonts.Medium,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = tabBtn,
        })

        -- Content scroll frame for this tab
        local tabContent = create("ScrollingFrame", {
            Name = "TabContent_" .. tabName,
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = theme.TextMuted,
            ScrollBarImageTransparency = 0.5,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            BorderSizePixel = 0,
            Visible = false,
            Parent = contentArea,
        })
        addPadding(tabContent, 12, 16, 12, 16)
        local contentList = addList(tabContent, Enum.FillDirection.Vertical, 6)

        local tabData = {
            Button = tabBtn,
            Content = tabContent,
            Label = tabLabel,
            Indicator = indicator,
            Name = tabName,
        }
        table.insert(windowState.Tabs, tabData)

        -- Tab switching logic
        local function activateTab()
            if windowState.ActiveTab == tabData then return end

            -- Deactivate previous
            if windowState.ActiveTab then
                local prev = windowState.ActiveTab
                prev.Content.Visible = false
                tween(prev.Button, Tweens.Medium, { BackgroundTransparency = 1 })
                tween(prev.Label, Tweens.Medium, { TextColor3 = theme.TextDim })
                tween(prev.Indicator, Tweens.Medium, { Size = UDim2.new(0, 3, 0, 0) })
            end

            -- Activate current
            windowState.ActiveTab = tabData
            tabContent.Visible = true
            tabContent.CanvasPosition = Vector2.new(0, 0)

            tween(tabBtn, Tweens.Medium, { BackgroundTransparency = 0.85 })
            tween(tabLabel, Tweens.Medium, { TextColor3 = theme.Text })
            tween(indicator, Tweens.Bounce, { Size = UDim2.new(0, 3, 0, 18) })

            -- Fade in content items
            for _, child in ipairs(tabContent:GetChildren()) do
                if child:IsA("GuiObject") and not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                    child.BackgroundTransparency = 1
                    local targetTransp = child:GetAttribute("TargetTransparency") or 0
                    tween(child, Tweens.Smooth, { BackgroundTransparency = targetTransp })
                end
            end
        end

        tabBtn.MouseButton1Click:Connect(activateTab)
        tabBtn.MouseEnter:Connect(function()
            if windowState.ActiveTab ~= tabData then
                tween(tabBtn, Tweens.Fast, { BackgroundTransparency = 0.9 })
            end
        end)
        tabBtn.MouseLeave:Connect(function()
            if windowState.ActiveTab ~= tabData then
                tween(tabBtn, Tweens.Fast, { BackgroundTransparency = 1 })
            end
        end)

        -- Auto-activate first tab
        if #windowState.Tabs == 1 then
            activateTab()
        end

        -- ============================================================
        -- ELEMENTS
        -- ============================================================
        local Tab = {}

        -- TOGGLE
        function Tab:Toggle(opts)
            opts = opts or {}
            local name = opts.Name or "Toggle"
            local default = opts.Default or false
            local callback = opts.Callback or function() end
            local state = default

            local container = create("Frame", {
                Name = "Toggle_" .. name,
                Size = UDim2.new(1, 0, 0, 38),
