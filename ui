                    Position = UDim2.new(0, 14, 0.5, 0),
                    BackgroundColor3 = theme.Border,
                    BackgroundTransparency = 0.6,
                    BorderSizePixel = 0,
                    Parent = container,
                })
            end
        end

        -- COLOR PICKER
        function Tab:ColorPicker(opts)
            opts = opts or {}
            local name = opts.Name or "Color"
            local default = opts.Default or Color3.new(1, 0, 0)
            local callback = opts.Callback or function() end
            local current = default
            local expanded = false

            local container = create("Frame", {
                Name = "ColorPicker_" .. name,
                Size = UDim2.new(1, 0, 0, 38),
                BackgroundColor3 = theme.SurfaceAlt,
                BackgroundTransparency = 0.3,
                BorderSizePixel = 0,
                ClipsDescendants = true,
                Parent = tabContent,
            })
            container:SetAttribute("TargetTransparency", 0.3)
            addCorner(container, 8)
            addStroke(container, theme.Border, 1, 0.7)

            create("TextLabel", {
                Size = UDim2.new(1, -70, 0, 38),
                Position = UDim2.new(0, 14, 0, 0),
                BackgroundTransparency = 1,
                Text = name,
                TextColor3 = theme.Text,
                TextSize = 13,
                Font = fonts.Medium,
                TextXAlignment = Enum.TextXAlignment.Left,
                Parent = container,
            })

            local preview = create("TextButton", {
                Name = "Preview",
                Size = UDim2.new(0, 32, 0, 20),
                Position = UDim2.new(1, -46, 0, 9),
                BackgroundColor3 = current,
                BorderSizePixel = 0,
                Text = "",
                AutoButtonColor = false,
                Parent = container,
            })
            addCorner(preview, 6)
            addStroke(preview, Color3.new(1,1,1), 1, 0.8)

            -- HSV sliders area
            local pickerArea = create("Frame", {
                Name = "PickerArea",
                Size = UDim2.new(1, -28, 0, 90),
                Position = UDim2.new(0, 14, 0, 44),
                BackgroundTransparency = 1,
                Parent = container,
            })

            local h, s, v = current:ToHSV()

            local sliderNames = {"Hue", "Saturation", "Brightness"}
            local sliderValues = {h, s, v}
            local sliderLabels = {}
            local sliderFills = {}

            for i, sName in ipairs(sliderNames) do
                local row = create("Frame", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0, (i - 1) * 30),
                    BackgroundTransparency = 1,
                    Parent = pickerArea,
                })

                create("TextLabel", {
                    Size = UDim2.new(0, 60, 1, 0),
                    BackgroundTransparency = 1,
                    Text = sName:sub(1, 3),
                    TextColor3 = theme.TextMuted,
                    TextSize = 11,
                    Font = fonts.SemiBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local track = create("Frame", {
                    Size = UDim2.new(1, -75, 0, 8),
                    Position = UDim2.new(0, 60, 0.5, -4),
                    BackgroundColor3 = theme.Border,
                    BorderSizePixel = 0,
                    ClipsDescendants = true,
                    Parent = row,
                })
                addCorner(track, 4)

                local fillBar = create("Frame", {
                    Size = UDim2.new(sliderValues[i], 0, 1, 0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0,
                    Parent = track,
                })
                addCorner(fillBar, 4)
                sliderFills[i] = fillBar

                -- Hue bar gets a rainbow gradient
                if i == 1 then
                    local grad = Instance.new("UIGradient")
                    grad.Color = ColorSequence.new({
                        ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
                        ColorSequenceKeypoint.new(0.17, Color3.fromHSV(0.17, 1, 1)),
                        ColorSequenceKeypoint.new(0.33, Color3.fromHSV(0.33, 1, 1)),
                        ColorSequenceKeypoint.new(0.5, Color3.fromHSV(0.5, 1, 1)),
                        ColorSequenceKeypoint.new(0.67, Color3.fromHSV(0.67, 1, 1)),
                        ColorSequenceKeypoint.new(0.83, Color3.fromHSV(0.83, 1, 1)),
                        ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
                    })
                    grad.Parent = track
                    fillBar:Destroy()
                    sliderFills[i] = nil

                    -- Indicator line
                    local indicator = create("Frame", {
                        Size = UDim2.new(0, 2, 1, 2),
                        Position = UDim2.new(h, -1, 0, -1),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BorderSizePixel = 0,
                        ZIndex = 5,
                        Parent = track,
                    })
                    sliderFills[i] = indicator
                end

                -- Drag
                local draggingColor = false
                track.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingColor = true
                        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        sliderValues[i] = rel
                        if i == 1 then
                            sliderFills[i].Position = UDim2.new(rel, -1, 0, -1)
                        else
                            tween(sliderFills[i], Tweens.Fast, { Size = UDim2.new(rel, 0, 1, 0) })
                        end
                        h, s, v = sliderValues[1], sliderValues[2], sliderValues[3]
                        current = Color3.fromHSV(h, s, v)
                        preview.BackgroundColor3 = current
                        callback(current)
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if draggingColor and (input.UserInputType == Enum.UserInputType.MouseMovement) then
                        local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                        sliderValues[i] = rel
                        if i == 1 then
                            sliderFills[i].Position = UDim2.new(rel, -1, 0, -1)
                        else
                            sliderFills[i].Size = UDim2.new(rel, 0, 1, 0)
                        end
                        h, s, v = sliderValues[1], sliderValues[2], sliderValues[3]
                        current = Color3.fromHSV(h, s, v)
                        preview.BackgroundColor3 = current
                        callback(current)
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        draggingColor = false
                    end
                end)
            end

            preview.MouseButton1Click:Connect(function()
                expanded = not expanded
                tween(container, Tweens.Smooth, {
                    Size = UDim2.new(1, 0, 0, expanded and 140 or 38)
                })
            end)

            -- Hover
            container.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.15 })
                end
            end)
            container.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.3 })
                end
            end)

            callback(default)

            return {
                Set = function(_, c) current = c; preview.BackgroundColor3 = c; callback(c) end,
                Get = function() return current end,
            }
        end

        return Tab
    end

    -- Notify on creation
    task.spawn(function()
        task.wait(0.6)
        Mercury:Notify({
            Title = "Mercury",
            Message = "Interface loaded successfully.",
            Duration = 3,
        })
    end)

    table.insert(self.Windows, { Gui = screenGui, State = windowState })
    return Window
end

return Mercury
