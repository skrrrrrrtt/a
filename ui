            end)
            hoverBtn.MouseLeave:Connect(function()
                tween(container, Tweens.Fast, { BackgroundTransparency = 0.3 })
            end)

            return {
                Set = function(_, key) current = key; keyBtn.Text = "[" .. getKeyName(current) .. "]"; callback(current) end,
                Get = function() return current end,
            }
        end

