                expanded = not expanded
                tween(arrow, Tweens.Fast, { Rotation = expanded and 180 or 0 })

                local itemCount = #items
                local expandedHeight = 38 + 4 + (itemCount * 30)
                tween(container, Tweens.Smooth, {
                    Size = UDim2.new(1, 0, 0, expanded and expandedHeight or 38)
                })
            end)

            -- Hover
            container.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.15 })
                end
            end)
            container.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseMovement then
                    tween(container, Tweens.Fast, { BackgroundTransparency = 0.3 })
                end
            end)

            callback(default)

            return {
                Set = function(_, v)
                    selected = v
                    selectedBtn.Text = v
                    callback(v)
                end,
                Get = function() return selected end,
                Refresh = function(_, newItems)
                    items = newItems
                    for _, ch in ipairs(itemHolder:GetChildren()) do
                        if ch:IsA("TextButton") then ch:Destroy() end
                    end
                    for i, item in ipairs(newItems) do
                        local itemBtn = create("TextButton", {
                            Name = "Item_" .. item,
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = theme.Background,
                            BackgroundTransparency = 0.5,
                            BorderSizePixel = 0,
                            Text = item,
                            TextColor3 = (item == selected) and theme.Accent or theme.TextDim,
                            TextSize = 12,
                            Font = fonts.Medium,
                            AutoButtonColor = false,
                            LayoutOrder = i,
                            Parent = itemHolder,
                        })
                        addCorner(itemBtn, 6)
                        itemBtn.MouseButton1Click:Connect(function()
                            selected = item; selectedBtn.Text = item; callback(item)
                            expanded = false
                            tween(arrow, Tweens.Fast, { Rotation = 0 })
                            tween(container, Tweens.Smooth, { Size = UDim2.new(1, 0, 0, 38) })
                        end)
                    end
                end,
            }
        end

